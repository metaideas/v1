import { createBullBoard } from "@bull-board/api"
import { BullMQAdapter } from "@bull-board/api/bullMQAdapter"
import { HonoAdapter } from "@bull-board/hono"
import { queueNames } from "@v1/jobs/queue-names"
import { Queue } from "bullmq"
import { basicAuth } from "hono/basic-auth"
import { serveStatic } from "hono/bun"
import { csrf } from "hono/csrf"
import { createClient } from "redis"
import { ENV } from "#shared/env.generated.ts"
import { log } from "#shared/logger.ts"
import { factory } from "#shared/utils.ts"

const JOBS_DASHBOARD_PATH = "/jobs"

function createJobsDashboard(credentials: { password: string; username: string }) {
  const connection = createClient({ url: ENV.JOBS_REDIS_URL })
  connection.on("error", (error) => {
    log.error({ error, message: "Jobs dashboard connection error", scope: "jobs" })
  })
  // The client reconnects on its own, so connecting rejects only once it stops reconnecting.
  connection.connect().catch((error: unknown) => {
    log.error({ error, message: "Jobs dashboard connection closed", scope: "jobs" })
  })

  const queues = queueNames.map((name) => {
    const queue = new Queue(name, { connection })
    // The queue re-emits its connection's errors, which the connection already logs. Without a
    // listener, BullMQ prints each one to the console.
    queue.on("error", (error) => {
      log.debug({ error, message: "Jobs dashboard queue error", queue: name, scope: "jobs" })
    })

    return queue
  })
  const serverAdapter = new HonoAdapter(serveStatic).setBasePath(JOBS_DASHBOARD_PATH)

  createBullBoard({
{{#if theme}}
    // Copied from the shadcn theme in packages/ui when this file was generated.
    options: { uiConfig: { theme: {{{theme}}} } },
{{/if}}
    queues: queues.map((queue) => new BullMQAdapter(queue)),
    serverAdapter,
  })

  return {
    async close() {
      await Promise.all(queues.map((queue) => queue.close()))

      if (connection.isReady) {
        await connection.close()
      } else if (connection.isOpen) {
        connection.destroy()
      }
    },
    path: JOBS_DASHBOARD_PATH,
    // Browsers resend cached Basic Auth credentials on cross-site form posts, so reject mutations
    // that do not come from the dashboard's own origin.
    routes: factory
      .createApp()
      .use(csrf())
      .use(basicAuth(credentials))
      .route("/", serverAdapter.registerPlugin()),
  }
}

/**
 * The bull-board dashboard for every job queue. It is undefined when no dashboard credentials are
 * configured.
 */
export const jobsDashboard =
  ENV.JOBS_DASHBOARD_USERNAME && ENV.JOBS_DASHBOARD_PASSWORD
    ? createJobsDashboard({
        password: ENV.JOBS_DASHBOARD_PASSWORD,
        username: ENV.JOBS_DASHBOARD_USERNAME,
      })
    : undefined
