{
  "name": "v1",
  "private": true,
  "type": "module",
  "scripts": {
    "analyze": "adamantite analyze",
    "boundaries": "turbo boundaries",
    "build": "turbo build",
    "bump:deps": "pnpm update --interactive --recursive",
    "check": "adamantite check",
    "clean": "turbo clean && git clean -xdf .cache .turbo dist node_modules",
    "codegen": "turbo run codegen --continue --ui=stream --output-logs=errors-only",
    "db:migrate": "turbo --filter @v1/database migrate",
    "db:push": "turbo --filter @v1/database push",
    "dev": "turbo run dev",
    "dev:apps": "turbo run dev --filter=!@v1/*",
    "dev:packages": "turbo run dev --filter=@v1/*",
    "docker:down": "docker compose -f infra/local/docker-compose.yml down",
    "docker:up": "docker compose -f infra/local/docker-compose.yml up -d --remove-orphans",
    "env:check": "turbo run env:check --continue",
    "env:scan": "turbo run env:scan --continue",
    "fix": "adamantite fix",
    "generate": "turbo generate",
    "scripts": "node scripts/index.ts",
    "start": "turbo run start",
    "template": "node scripts/index.ts template",
    "test": "turbo run test test:template",
    "test:template": "vitest run",
    "test:watch": "turbo watch test test:template"
  },
  "devDependencies": {
    "@turbo/gen": "2.11.11",
    "@types/node": "26.6.4",
    "adamantite": "0.47.0",
    "citty": "0.2.2",
    "confbox": "0.3.1",
    "consola": "3.4.2",
    "knip": "6.42.0",
    "magicast": "0.5.5",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "oxlint-plugin-react-doctor": "0.9.18",
    "sherif": "1.13.0",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "turbo": "2.11.11",
    "typescript": "7.0.2",
    "varlock": "1.21.1",
    "vitest": "5.1.0",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.0",
  "v1": {
    "cleanupPaths": [
      ".github/workflows/pullfrog.yml",
      "scripts/codemods",
      "apps/docs/vercel.json",
      "apps/web/vercel.json"
    ],
    "cleanupSections": [
      "AGENTS.md"
    ]
  }
}
