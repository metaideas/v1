{
  "name": "api",
  "private": true,
  "description": "Hono API running on Bun",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "varlock run -- bun --no-env-file --watch src/index.ts",
    "env:check": "varlock load",
    "start": "varlock run -- bun --no-env-file --bun src/index.ts"
  },
  "dependencies": {
    "@arcjet/ip": "1.9.1",
    "@hono/standard-validator": "0.2.3",
    "@hono/trpc-server": "0.4.2",
    "@scalar/hono-api-reference": "0.9.48",
    "@trpc/server": "11.8.1",
    "@v1/auth": "workspace:*",
    "@v1/database": "workspace:*",
    "@v1/email": "workspace:*",
    "@v1/jobs": "workspace:*",
    "@v1/storage": "workspace:*",
    "@v1/utils": "workspace:*",
    "@v1/workflows": "workspace:*",
    "evlog": "2.30.0",
    "hono": "4.12.32",
    "hono-openapi": "1.3.1",
    "hono-rate-limiter": "0.5.3",
    "humanspan": "0.2.0",
    "ioredis": "5.11.1",
    "std-env": "4.2.0",
    "superjson": "2.2.6",
    "unstorage": "1.17.5",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
