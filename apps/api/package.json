{
  "name": "api",
  "private": true,
  "description": "Hono API running on Node",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "varlock run -- node --import @oxc-node/core/register --watch src/index.ts",
    "env:check": "varlock load",
    "start": "varlock run -- node --import @oxc-node/core/register src/index.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@hono/trpc-server": "0.4.2",
    "@oxc-node/core": "1.0.1",
    "@sanely/duration": "0.1.0",
    "@sanely/ratelimit": "0.1.0",
    "@sanely/request": "0.1.0",
    "@sanely/try": "0.1.0",
    "@scalar/hono-api-reference": "0.12.10",
    "@trpc/server": "11.19.0",
    "@v1/auth": "workspace:*",
    "@v1/database": "workspace:*",
    "@v1/email": "workspace:*",
    "@v1/jobs": "workspace:*",
    "@v1/realtime": "workspace:*",
    "@v1/storage": "workspace:*",
    "@v1/utils": "workspace:*",
    "@v1/workflows": "workspace:*",
    "evlog": "2.30.0",
    "hono": "4.13.13",
    "hono-openapi": "1.3.3",
    "ioredis": "6.0.0",
    "redis": "6.2.1",
    "std-env": "4.3.0",
    "superjson": "2.2.6",
    "unstorage": "1.17.5",
    "varlock": "1.21.1"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
