# @currentEnv=$VARLOCK_ENV
# @generateTsTypes(path=./src/shared/env.generated.ts, exposeEnv=local)
# @import(../../packages/auth/env/.env.server)
# @import(../../packages/database/env/.env.server)
# @import(../../packages/email/env/.env.server)
# @import(../../packages/jobs/env/.env.server)
# @import(../../packages/storage/env/.env.server)
# @import(../../packages/workflows/env/.env.server)
# @defaultRequired=true @defaultSensitive=true

# ---

# Public URL where the API is reachable.
# @public @type=url
BASE_URL=

# Browser origins allowed by API CORS middleware.
# @public @type=array(string)
ALLOWED_API_ORIGINS=

# Optional parent domain for session cookies, such as `example.com`. Set it when the API and its
# browser clients use sibling subdomains so both hosts receive the session.
# @optional @public
AUTH_COOKIE_DOMAIN=

# Redis connection URL for key-value storage.
# @type=url
REDIS_URL=

# Optional hosting platform whose client IP header the API trusts to rate limit requests. Set it
# only when every request reaches the API through that platform, because clients can forge the
# header otherwise.
# @optional @public @type=enum(cloudflare, firebase, fly-io, render, vercel)
CLIENT_IP_PLATFORM=

# Optional addresses or CIDR ranges of proxies in front of the API, such as a load balancer. The API
# skips them to read the client IP from forwarding headers.
# @optional @public @type=array(string)
TRUSTED_PROXIES=

# Local server port.
# @public @type=port
PORT=3000

# Arcjet security credential.
ARCJET_KEY=
