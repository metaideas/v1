---
import { getLocale } from "#shared/internationalization/runtime.js"
import { m } from "#shared/internationalization/messages.js"
import { SITE_NAME, SITE_URL } from "#shared/constants.ts"
import "@v1/ui/globals.css"

type Props = {
  description?: string
  title?: string
}

const locale = getLocale()
const { description = m.web_home_description(), title = SITE_NAME } = Astro.props
const canonicalUrl = new URL(Astro.url.pathname, SITE_URL)
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-light.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
    <link rel="icon" href="/favicon-dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <script is:inline type="module">
      const storedTheme = localStorage.getItem("v1-theme")
      const prefersDark = globalThis.matchMedia("(prefers-color-scheme: dark)").matches
      const theme = storedTheme === "dark" || storedTheme === "light" ? storedTheme : prefersDark ? "dark" : "light"
      document.documentElement.classList.add(theme)
      export default theme
    </script>
    <script>
      import { init } from "@plausible-analytics/tracker"

      init({ domain: location.hostname })
    </script>
    <title>{title}</title>
  </head>
  <body class="bg-background text-foreground antialiased">
    <slot />
  </body>
</html>
