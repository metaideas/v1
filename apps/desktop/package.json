{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop application with TanStack Router",
  "type": "module",
  "main": ".vite/build/main.js",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "electron-forge package",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo .vite dist node_modules out",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "dev": "electron-forge start",
    "env:check": "varlock load",
    "env:scan": "test -d dist && varlock scan --path .env.schema dist",
    "env:scan:build": "bun --bun vite build --config vite.renderer.config.ts",
    "make": "electron-forge make"
  },
  "dependencies": {
    "@tanstack/react-devtools": "0.10.9",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-devtools": "5.91.2",
    "@tanstack/react-router": "1.170.41",
    "@tanstack/react-router-devtools": "1.167.0",
    "@v1/ui": "workspace:*",
    "electron-squirrel-startup": "1.0.1",
    "evlog": "2.30.0",
    "faultier": "3.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "typedport": "0.3.0",
    "varlock": "1.16.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@electron/fuses": "2.1.3",
    "@inlang/paraglide-js": "2.23.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/devtools-vite": "0.8.3",
    "@tanstack/router-plugin": "1.168.23",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/electron-squirrel-startup": "1.0.2",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.1.9",
    "@varlock/vite-integration": "1.4.0",
    "@vitejs/plugin-react": "6.1.0",
    "electron": "43.4.0",
    "oxc-transform-react": "0.145.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
