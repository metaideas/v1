{
  "name": "docs",
  "private": true,
  "description": "Documentation site using Astro and Starlight",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "astro": "astro",
    "build": "astro build",
    "bump:deps": "pnpm update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "pnpm run \"/^codegen:(env|astro)$/\"",
    "codegen:astro": "pnpm run codegen:i18n && pnpm run codegen:types",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization --strategy url globalVariable baseLocale",
    "codegen:types": "astro sync",
    "dev": "astro dev",
    "env:check": "varlock load",
    "env:scan": "test -d dist && varlock scan --path .env.schema --path .env.development dist",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/starlight": "0.42.5",
    "@astrojs/starlight-tailwind": "5.0.0",
    "@plausible-analytics/tracker": "0.4.6",
    "astro": "7.3.5",
    "sharp": "0.35.5",
    "varlock": "1.21.1"
  },
  "devDependencies": {
    "@astrojs/ts-plugin": "1.10.12",
    "@inlang/paraglide-js": "2.25.4",
    "@tailwindcss/vite": "4.3.3",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "@varlock/astro-integration": "1.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2"
  }
}
