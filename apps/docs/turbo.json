{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["application"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"],
      "env": ["PUBLIC_SITE_URL"]
    },
    "codegen": {
      "inputs": ["$TURBO_EXTENDS$", "$TURBO_ROOT$/docs/**"],
      "outputs": ["$TURBO_EXTENDS$", ".astro/**"],
      "env": ["PUBLIC_SITE_URL"]
    }
  }
}
