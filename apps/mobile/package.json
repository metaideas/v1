{
  "name": "mobile",
  "private": true,
  "description": "Expo application deployed with EAS",
  "main": "src/index.ts",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "android": "varlock run -- expo run:android",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo .expo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "bun run scripts/codegen.ts",
    "dev": "varlock run -- expo start --port ${PORT:-3002}",
    "dev:android": "varlock run -- expo start --android",
    "dev:ios": "varlock run -- expo start --ios",
    "doctor": "expo-doctor",
    "env:check": "varlock load",
    "env:scan": "test -d dist && varlock scan --path .env.schema dist",
    "env:scan:build": "varlock run -- expo export",
    "install:check": "expo install --check",
    "install:fix": "expo install --fix",
    "ios": "varlock run -- expo run:ios",
    "prebuild": "varlock run -- expo prebuild --clean",
    "start": "varlock run -- expo start",
    "test": "bun test",
    "web": "varlock run -- expo start --web"
  },
  "dependencies": {
    "@expo/metro-runtime": "57.0.16",
    "@expo/react-native-action-sheet": "4.1.1",
    "@expo/ui": "57.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@rn-primitives/portal": "1.5.2",
    "@tanstack/query-async-storage-persister": "5.90.18",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-query-persist-client": "5.90.18",
    "cn": "0.3.0",
    "evlog": "2.30.0",
    "expo": "57.0.26",
    "expo-constants": "57.0.20",
    "expo-dev-client": "57.0.19",
    "expo-font": "57.0.4",
    "expo-glass-effect": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-symbols": "57.0.3",
    "expo-system-ui": "57.0.4",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "0.21.2",
    "react-native-worklets": "0.10.1",
    "superjson": "2.2.6",
    "tailwindcss": "4.3.3",
    "uniwind": "1.10.1",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.23.0",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.2.4",
    "@varlock/expo-integration": "1.2.0",
    "babel-plugin-react-compiler": "1.0.0",
    "babel-preset-expo": "57.0.13",
    "expo-doctor": "1.20.1",
    "typescript": "7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript"
      ]
    }
  }
}
