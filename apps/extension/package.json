{
  "name": "extension",
  "private": true,
  "description": "Browser extension using WXT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "bun run --parallel \"codegen:*\"",
    "codegen:env": "varlock codegen",
    "codegen:i18n": "paraglide-js compile --project ../../tooling/internationalization/project.inlang --outdir ./src/shared/internationalization",
    "codegen:types": "wxt prepare",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "env:check": "varlock load",
    "env:scan": "test -d .output && varlock scan --path .env.schema .output",
    "postinstall": "wxt prepare",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@v1/ui": "workspace:*",
    "evlog": "2.30.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "varlock": "1.21.1",
    "wouter": "3.13.0"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "2.25.4",
    "@tailwindcss/vite": "4.3.3",
    "@tooling/internationalization": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/chrome": "0.3.4",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.1.9",
    "@varlock/vite-integration": "1.5.2",
    "@vitejs/plugin-react": "6.1.2",
    "@wxt-dev/auto-icons": "1.1.2",
    "@wxt-dev/module-react": "1.2.2",
    "oxc-transform-react": "0.153.0",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "web-ext": "10.7.0",
    "wxt": "0.21.4"
  }
}
