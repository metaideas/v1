{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "extends": ["//"],
  "tags": ["application"],
  "tasks": {
    "build": {
      "env": [
        "AUTH_*",
        "DATABASE_URL",
        "EMAIL_FROM",
        "GITHUB_*",
        "GOOGLE_*",
        "PORT",
        "PUBLIC_*",
        "RESEND_API_KEY",
        "RUN_PRODUCTION_MIGRATIONS",
        "SMTP_URL"
      ],
      "outputs": [".output/**"]
    }
  }
}
