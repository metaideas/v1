{
  "name": "worker",
  "private": true,
  "description": "Background worker for jobs and workflows running on Node",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "varlock codegen",
    "dev": "varlock run -- node --watch src/index.ts",
    "env:check": "varlock load",
    "start": "varlock run -- node src/index.ts"
  },
  "dependencies": {
    "@v1/jobs": "workspace:*",
    "@v1/utils": "workspace:*",
    "@v1/workflows": "workspace:*",
    "evlog": "2.30.0",
    "std-env": "4.3.0",
    "varlock": "1.21.1"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
