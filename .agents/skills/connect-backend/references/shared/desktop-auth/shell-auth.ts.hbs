import { createAuthClient } from "{{authPackage}}/client"
import { AUTH_API_COOKIE_PREFIX } from "{{authPackage}}/constants"
import { electronClient } from "{{authPackage}}/electron"
import { buildApiUrl } from "#shared/utils.ts"

/**
 * The app's identifier, from `packagerConfig.appBundleId` in forge.config.ts. The API trusts
 * requests from the main process through it, as `com.desktop.app:/` in `ALLOWED_API_ORIGINS`.
 */
const PROTOCOL = "com.desktop.app"

export const auth = createAuthClient(buildApiUrl("/auth"), [
  electronClient({
    cookiePrefix: AUTH_API_COOKIE_PREFIX,
    protocol: PROTOCOL,
    // Better Auth opens this page for social sign-in in the system browser, which the app does not
    // use yet. Email and password sign in from the main process.
    signInURL: buildApiUrl("/"),
  }),
])
