{
  "name": "@metaideas/create-v1",
  "version": "1.4.0",
  "description": "Create a project from the v1 template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaideas/v1.git",
    "directory": "tooling/create"
  },
  "bin": {
    "create-v1": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "bump:deps": "pnpm update --interactive",
    "changeset": "cd ../.. && changeset",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "prepack": "tsdown",
    "release": "cd ../.. && changeset publish",
    "version": "cd ../.. && changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "tsdown": "0.23.5"
  },
  "engines": {
    "node": ">=26"
  }
}
