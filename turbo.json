{
  "$schema": "https://v2-10-7.turborepo.dev/schema.json",
  "boundaries": {
    "tags": {
      "api-application": {
        "dependencies": {
          "deny": ["application"]
        },
        "dependents": {
          "allow": ["application"]
        }
      },
      "application": {
        "dependencies": {
          "deny": ["application"]
        },
        "dependents": {
          "allow": []
        }
      }
    }
  },
  "globalPassThroughEnv": ["CI", "VARLOCK_ENV", "_VARLOCK_ENV_KEY"],
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["codegen"],
      "env": [
        "ALLOWED_API_ORIGINS",
        "ARCJET_KEY",
        "AUTH_*",
        "BASE_URL",
        "DATABASE_URL",
        "EMAIL_FROM",
        "FILES_API_SECRET",
        "GITHUB_*",
        "GOOGLE_*",
        "INNGEST_*",
        "JOBS_REDIS_URL",
        "PORT",
        "PUBLIC_*",
        "REDIS_URL",
        "RESEND_API_KEY",
        "RUN_PRODUCTION_MIGRATIONS",
        "S3_*",
        "SMTP_URL",
        "STRIPE_*"
      ]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/env/**",
        "$TURBO_ROOT$/tooling/internationalization/messages/**",
        "$TURBO_ROOT$/tooling/internationalization/project.inlang/settings.json"
      ],
      "outputs": [
        "src/env.generated.ts",
        "src/shared/env.generated.ts",
        "src/shared/internationalization/**"
      ]
    },
    "env:check": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "env:scan": {
      "cache": false,
      "dependsOn": ["build"]
    }
  },
  "ui": "tui"
}
