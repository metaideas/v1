{
  "$schema": "https://v2-11-7.turborepo.dev/schema.json",
  "agentGuidance": false,
  "boundaries": {
    "tags": {
      "api-application": {
        "dependencies": {
          "deny": ["application"]
        },
        "dependents": {
          "allow": ["application"]
        }
      },
      "application": {
        "dependencies": {
          "deny": ["application"]
        },
        "dependents": {
          "allow": []
        }
      },
      "capability": {
        "dependencies": {
          "allow": ["foundation", "tooling"]
        }
      },
      "composing": {
        "dependencies": {
          "allow": ["capability", "foundation", "tooling"]
        }
      },
      "core": {
        "dependencies": {
          "allow": ["tooling", "utils"]
        }
      },
      "ui": {
        "dependencies": {
          "allow": ["tooling"]
        }
      },
      "utils": {
        "dependencies": {
          "allow": ["tooling"]
        }
      }
    }
  },
  "globalPassThroughEnv": ["CI", "VARLOCK_ENV", "_VARLOCK_ENV_KEY"],
  "concurrency": "15",
  "tasks": {
    "build": {
      "dependsOn": ["codegen"]
    },
    "clean": {
      "cache": false,
      "dependsOn": ["^clean"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "migrate": {
      "cache": false
    },
    "push": {
      "cache": false,
      "interactive": true
    },
    "start": {
      "cache": false,
      "persistent": true
    },
    "codegen": {
      "dependsOn": ["^codegen"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/env/**",
        "$TURBO_ROOT$/tooling/internationalization/messages/**",
        "$TURBO_ROOT$/tooling/internationalization/project.inlang/settings.json"
      ],
      "outputs": [
        "src/env.generated.ts",
        "src/shared/env.generated.ts",
        "src/shared/internationalization/**"
      ]
    },
    "env:check": {
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "env:scan": {
      "cache": false,
      "dependsOn": ["build"]
    },
    "test": {
      // `codegen` depends on `^codegen`, which Turborepo hashes in every dependency, even one without
      // a codegen script. A change in a workspace this one depends on therefore reruns its tests.
      "dependsOn": ["codegen"]
    },
    // Tests for the repository checks, skill scripts, and template recipes that are not workspaces.
    "//#test:template": {}
  },
  "ui": "tui"
}
