{
  "name": "@v1/auth",
  "private": true,
  "description": "Authentication utilities using Better Auth",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./constants": "./src/constants.ts",
    "./electron": "./src/electron.ts",
    "./expo": "./src/expo.ts",
    "./server": "./src/server.ts",
    "./start": "./src/start.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "secret": "bunx auth@latest secret",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "@better-auth/electron": "1.7.18",
    "@better-auth/expo": "1.7.18",
    "@v1/core": "workspace:*",
    "better-auth": "1.7.18",
    "conf": "15.1.0",
    "drizzle-orm": "1.0.0-rc.5",
    "humanspan": "0.3.0"
  },
  "devDependencies": {
    "@tooling/testing": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
