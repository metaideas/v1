{
  "name": "@v1/storage",
  "private": true,
  "description": "File storage policy, gateway, and React client using Files SDK",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./constants": "./src/constants.ts",
    "./react": "./src/react.ts",
    "./server": "./src/server.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/lib-storage": "3.1146.0",
    "@aws-sdk/s3-presigned-post": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "@sanely/duration": "0.1.0",
    "@sanely/try": "0.1.0",
    "@v1/core": "workspace:*",
    "@v1/utils": "workspace:*",
    "files-sdk": "2.6.2"
  },
  "devDependencies": {
    "@tooling/testing": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "peerDependencies": {
    "react": "*"
  }
}
