# File storage runtime contract.
# @defaultRequired=true @defaultSensitive=true

# ---

# Shared credential that signs the gateway's upload round-trip tokens.
# @type=string(minLength=32)
FILES_API_SECRET=

# Object-storage access identifier.
S3_ACCESS_KEY_ID=

# Object-storage bucket name.
# @public
S3_BUCKET=

# Optional S3-compatible endpoint.
# @optional @public @type=url
S3_ENDPOINT=

# Object-storage region, such as `us-east-1`, which local MinIO from Docker Compose uses.
# @public
S3_REGION=

# Object-storage secret credential.
S3_SECRET_ACCESS_KEY=
