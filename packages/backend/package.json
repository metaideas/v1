{
  "name": "@v1/backend",
  "private": true,
  "description": "Convex backend with Better Auth integration",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./api": "./src/functions/_generated/api.js",
    "./client": "./src/client/index.ts",
    "./client/*": "./src/client/*.ts",
    "./client/auth": "./src/client/auth/index.ts",
    "./client/auth/*": "./src/client/auth/*.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "convex dev",
    "env:set": "convex env set",
    "generate:auth": "bun run ./scripts/generate-schema.ts"
  },
  "dependencies": {
    "@convex-dev/better-auth": "0.12.5",
    "@convex-dev/react-query": "0.1.0",
    "@tanstack/react-query": "5.104.1",
    "@v1/auth": "workspace:*",
    "@v1/core": "workspace:*",
    "convex": "1.46.0",
    "fluent-convex": "0.13.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "*"
  }
}
