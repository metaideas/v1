# Inngest runtime contract.
# @defaultRequired=true @defaultSensitive=true

# ---

# Inngest server URL for the Dev Server or a self-hosted server. Leave it empty for Inngest Cloud.
# @optional @public @type=url
INNGEST_BASE_URL=

# Talks to the Inngest Dev Server, which needs no real keys and skips request signatures.
# @public @type=boolean
INNGEST_DEV=false

# Credential for sending events. The Dev Server accepts any value.
INNGEST_EVENT_KEY=

# Credential that authenticates workers and signs requests. A self-hosted server needs a hex value,
# such as the output of `openssl rand -hex 32`. The Dev Server accepts any value.
INNGEST_SIGNING_KEY=

# Previous signing credential accepted during rotation.
# @optional
INNGEST_SIGNING_KEY_FALLBACK=
