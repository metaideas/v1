{
  "name": "@v1/database",
  "private": true,
  "description": "Database client and ORM using Drizzle",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./client": "./src/client.ts",
    "./helpers/sql": "./src/helpers/sql.ts",
    "./schema": "./src/schema/index.ts",
    "./schemas": "./src/schemas.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "varlock codegen",
    "dev": "varlock run -- drizzle-kit studio --port ${PORT:-4000}",
    "env:check": "varlock load",
    "generate": "varlock run -- drizzle-kit generate",
    "migrate": "varlock run -- drizzle-kit migrate",
    "push": "varlock run -- drizzle-kit push",
    "reset": "varlock run -- node ./scripts/reset.ts",
    "seed": "varlock run -- node ./scripts/seed.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@v1/core": "workspace:*",
    "@v1/utils": "workspace:*",
    "drizzle-orm": "1.0.0-rc.5",
    "nanoid": "6.0.2",
    "postgres": "4.1.0",
    "varlock": "1.21.1"
  },
  "devDependencies": {
    "@tooling/testing": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "drizzle-kit": "1.0.0-rc.5",
    "drizzle-seed": "1.0.0-rc.5",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "workspace": {
    "knip": {
      "drizzle": {
        "config": [],
        "entry": [
          "drizzle.config.ts",
          "src/relations.ts",
          "src/schema/index.ts"
        ]
      },
      "entry": [
        "scripts/*.ts"
      ]
    }
  }
}
