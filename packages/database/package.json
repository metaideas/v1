{
  "name": "@v1/database",
  "private": true,
  "description": "Database client and ORM using Drizzle",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./helpers/*": "./src/helpers/*.ts",
    "./schema": "./src/schema.ts",
    "./schemas": "./src/schemas.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "codegen": "varlock codegen",
    "dev": "varlock run -- bun --bun drizzle-kit studio --port ${PORT:-4000}",
    "env:check": "varlock load",
    "generate": "varlock run -- bun --bun drizzle-kit generate",
    "migrate": "varlock run -- bun --bun drizzle-kit migrate",
    "push": "varlock run -- bun --bun drizzle-kit push",
    "reset": "varlock run -- bun --bun run ./scripts/reset.ts",
    "seed": "varlock run -- bun --bun run ./scripts/seed.ts"
  },
  "dependencies": {
    "@v1/core": "workspace:*",
    "@v1/utils": "workspace:*",
    "drizzle-orm": "0.45.2",
    "drizzle-zod": "0.8.3",
    "varlock": "1.16.0"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "drizzle-kit": "0.31.10",
    "drizzle-seed": "0.3.1",
    "postgres": "3.4.9",
    "typescript": "7.0.2"
  }
}
