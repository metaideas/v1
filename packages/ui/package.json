{
  "name": "@v1/ui",
  "private": true,
  "description": "Reusable UI components and design system using shadcn/ui",
  "license": "MIT",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./components/*": "./src/components/*.tsx",
    "./constants": "./src/constants.ts",
    "./globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "components:add": "shadcn add",
    "components:diff": "shadcn add --diff"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@shadcn/react": "0.3.1",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-table": "9.2.6",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "embla-carousel-react": "8.6.0",
    "humanspan": "0.3.0",
    "input-otp": "1.5.0",
    "react-day-picker": "10.0.2",
    "react-icons": "5.7.0",
    "react-resizable-panels": "4.14.2",
    "recharts": "3.10.1"
  },
  "devDependencies": {
    "@tooling/tsconfig": "workspace:*",
    "@types/react": "19.2.4",
    "@types/react-dom": "19.1.9",
    "shadcn": "4.21.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "react": "*"
  }
}
