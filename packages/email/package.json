{
  "name": "@v1/email",
  "private": true,
  "description": "Email templates and delivery through Resend or SMTP",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./errors": "./src/errors.ts",
    "./mailer": "./src/mailer.ts",
    "./transports": "./src/transports.ts"
  },
  "scripts": {
    "bump:deps": "pnpm update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "email dev --dir src/templates --port ${PORT:-4001}",
    "export": "email export --dir src/templates",
    "preview:build": "email build --dir src/templates",
    "test": "vitest run"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@sanely/duration": "0.1.0",
    "@sanely/errors": "0.1.0",
    "@sanely/try": "0.1.0",
    "@v1/core": "workspace:*",
    "nodemailer": "10.0.15",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.32.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.11.0",
    "@tooling/testing": "workspace:*",
    "@tooling/tsconfig": "workspace:*",
    "@types/node": "26.6.4",
    "@types/react": "19.2.4",
    "react-email": "6.11.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
