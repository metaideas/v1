{
  "name": "@v1/email",
  "private": true,
  "description": "Email templates and delivery through Resend or SMTP",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    "./mailer": "./src/mailer.ts",
    "./transports": "./src/transports.ts"
  },
  "scripts": {
    "bump:deps": "bun update --interactive",
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "dev": "email dev --dir src/templates --port ${PORT:-4001}",
    "export": "email export --dir src/templates",
    "preview:build": "email build --dir src/templates"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@v1/core": "workspace:*",
    "humanspan": "0.2.0",
    "nodemailer": "10.0.14",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "resend": "6.7.0",
    "tryharder": "0.4.0"
  },
  "devDependencies": {
    "@react-email/ui": "6.9.1",
    "@tooling/tsconfig": "workspace:*",
    "@types/bun": "1.4.2",
    "@types/react": "19.2.4",
    "react-email": "6.9.1",
    "typescript": "7.0.2"
  }
}
